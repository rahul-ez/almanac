# Copy this file to backend/.env and fill in real values. .env is gitignored —
# never commit it. See context/architecture.md's Environment Configuration
# table for what each variable is for.

# From your workspace URL, e.g. https://dbc-xxxxxxxx-xxxx.cloud.databricks.com
DATABRICKS_HOST=

# User Settings -> Developer -> Access tokens -> Generate new token
DATABRICKS_TOKEN=

# SQL Warehouses -> your warehouse -> Connection details (or the URL's ID segment)
SQL_WAREHOUSE_ID=

# Genie Space -> Copy the space ID from its URL
GENIE_SPACE_ID=

# Frozen by data-platform/notebooks/01_create_schema.sql — do not change
# unless you also changed the catalog name there.
UNITY_CATALOG_SCHEMA=campus_companion.campus

# Any value you choose — this is the shared code that grants the "council" role.
COUNCIL_ACCESS_CODE=change-me-council-code

# Any long random string — signs the session cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SIGNING_SECRET=change-me-signing-secret

# Any value you choose — checked against the token the Apps Script sends.
INGEST_TOKEN=change-me-ingest-token
